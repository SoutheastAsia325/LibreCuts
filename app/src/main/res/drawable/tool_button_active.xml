<?xml version="1.0" encoding="utf-8"?>
<!--
  工具按钮（选中）：浅色面 + 墨色描边环。
  注意：代码里选中态的文字/图标用的是 @color/toolTextActive（墨色），
  所以底面必须保持"浅面"（activeToolBackground），不能改成实心墨色，否则内容会看不见。
  描边用 @color/colorPrimary（浅色=黑环 / 深色=白环），保证单色方案下选中态依然醒目。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/activeToolBackground" />
    <corners android:radius="@dimen/radius_card" />
    <stroke
        android:width="@dimen/stroke_focus"
        android:color="@color/colorPrimary" />
</shape>
