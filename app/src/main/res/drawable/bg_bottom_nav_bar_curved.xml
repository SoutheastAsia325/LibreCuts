<?xml version="1.0" encoding="utf-8"?>
<!-- 顶部两角圆角的扁平毛玻璃栏 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glassFillElevated" />
            <corners android:topLeftRadius="@dimen/radius_card" android:topRightRadius="@dimen/radius_card" />
        </shape>
    </item>
    <item
        android:height="@dimen/glass_hairline"
        android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="@color/glassStrokeStrong" />
        </shape>
    </item>
</layer-list>
