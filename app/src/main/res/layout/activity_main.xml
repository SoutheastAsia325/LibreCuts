<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- 毛玻璃背景层：API 31+ 由 GlassUi.applyGlassBlur 做真实模糊，低版本退化为渐变 -->
    <View
        android:id="@+id/glassBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_glass_backdrop" />

    <View
        android:id="@+id/glassGlow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_glass_glow" />


    <!-- Top Header Bar -->
    <LinearLayout
        android:id="@+id/layoutTopHeader"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        android:background="@color/background">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/textColor"
                android:textSize="22sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Video Editor"
                android:textColor="@color/iconSecondary"
                android:textSize="11sp"
                android:fontFamily="sans-serif" />
        </LinearLayout>
    </LinearLayout>
    <!-- Projects Page Content（项目页：整行长方形列表，每排一个） -->
    <ScrollView
        android:id="@+id/layoutProjectsContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layoutTopHeader"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="120dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 主操作：新建项目（实心墨色，扁平无投影） -->
            <LinearLayout
                android:id="@+id/btnImport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="104dp"
                android:background="@drawable/bg_cta_primary"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_add_24"
                    app:tint="@color/colorOnPrimary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/str_new_project"
                        android:textColor="@color/colorOnPrimary"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:alpha="0.62"
                        android:text="@string/str_new_project_desc"
                        android:textColor="@color/colorOnPrimary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 次级操作：打开工程文件（ghost 按钮） -->
            <LinearLayout
                android:id="@+id/btnOpenProject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="64dp"
                android:background="@drawable/bg_ghost_button"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_arrow_up_right_24"
                    app:tint="@color/textColor" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/str_open_project_file"
                        android:textColor="@color/textColor"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/str_open_project_file_desc"
                        android:textColor="@color/iconSecondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 最近项目 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="10dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/str_recent_projects"
                android:textColor="@color/textColor"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/layoutProjectList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- 空状态 -->
            <LinearLayout
                android:id="@+id/layoutProjectsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_panel"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="28dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_folder_24"
                    app:tint="@color/iconSecondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/str_projects_empty"
                    android:textColor="@color/textColor"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/str_projects_empty_desc"
                    android:textColor="@color/iconSecondary"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Settings Page Content (Bento Style Layout) -->
    <ScrollView
        android:id="@+id/layoutSettingsContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layoutTopHeader"
        android:visibility="gone"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="100dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/str_settings"
                android:textColor="@color/textColor"
                android:textSize="24sp" />

            <!-- General Settings Bento Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_bento_secondary"
                android:orientation="vertical"
                android:padding="20dp"
                android:elevation="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/str_general"
                    android:textColor="@color/textColor"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp" />

                <!-- Appearance / Theme Mode Setting -->
                <LinearLayout
                    android:id="@+id/btnChangeTheme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/str_theme_appearance"
                        android:textColor="@color/textColor"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tvCurrentThemeMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/str_theme_follow_system"
                        android:textColor="@color/iconSecondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/outlineVariant"
                    android:layout_marginVertical="4dp" />

                <!-- App Language Setting -->
                <LinearLayout
                    android:id="@+id/btnChangeLanguage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="10dp">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/str_app_language"
                        android:textColor="@color/textColor"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium" />
                    
                    <TextView
                        android:id="@+id/tvCurrentLanguage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/str_system_default"
                        android:textColor="@color/iconSecondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/outlineVariant"
                    android:layout_marginVertical="4dp" />

                <!-- Video Export Folder Setting -->
                <LinearLayout
                    android:id="@+id/btnChangeExportFolder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="10dp">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/str_video_export_folder"
                        android:textColor="@color/textColor"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium" />
                    
                    <TextView
                        android:id="@+id/tvCurrentExportFolder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/str_default_movies_librecuts"
                        android:textColor="@color/iconSecondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/outlineVariant"
                    android:layout_marginVertical="4dp" />

                <!-- Audio Export Folder Setting -->
                <LinearLayout
                    android:id="@+id/btnChangeAudioExportFolder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="10dp">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/str_audio_export_folder"
                        android:textColor="@color/textColor"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium" />
                    
                    <TextView
                        android:id="@+id/tvCurrentAudioExportFolder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/str_default_music_librecuts"
                        android:textColor="@color/iconSecondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/outlineVariant"
                    android:layout_marginVertical="4dp" />

                <!-- Snapshot Export Folder Setting -->
                <LinearLayout
                    android:id="@+id/btnChangeSnapshotExportFolder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="10dp">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/str_snapshot_export_folder"
                        android:textColor="@color/textColor"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium" />
                    
                    <TextView
                        android:id="@+id/tvCurrentSnapshotExportFolder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/str_default_pictures_librecuts"
                        android:textColor="@color/iconSecondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/outlineVariant"
                    android:layout_marginVertical="4dp" />

                <!-- Haptic Feedback Setting -->
                <LinearLayout
                    android:id="@+id/btnToggleHapticFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/str_haptic_feedback"
                        android:textColor="@color/textColor"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tvCurrentHapticFeedback"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/str_haptic_enabled_desc"
                        android:textColor="@color/iconSecondary"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Editor & Rendering Bento Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_hero_bento_secondary"
                android:orientation="vertical"
                android:padding="20dp"
                android:elevation="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/str_editor_and_rendering"
                    android:textColor="@color/textColor"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp" />

                <!-- Fullscreen Editor Setting -->
                <LinearLayout
                    android:id="@+id/btnToggleFullscreenEditor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/str_fullscreen_editor"
                        android:textColor="@color/textColor"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tvCurrentFullscreenEditor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/str_fullscreen_enabled_desc"
                        android:textColor="@color/iconSecondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/outlineVariant"
                    android:layout_marginVertical="4dp" />

                <!-- Default Encoder Setting -->
                <LinearLayout
                    android:id="@+id/btnChangeDefaultEncoder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/str_default_encoder"
                        android:textColor="@color/textColor"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tvCurrentDefaultEncoder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/str_encoder_hardware"
                        android:textColor="@color/iconSecondary"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- System Bento Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_hero_bento_secondary"
                android:orientation="vertical"
                android:padding="20dp"
                android:elevation="4dp">

                <!-- Check for Updates Setting -->
                <LinearLayout
                    android:id="@+id/btnCheckForUpdates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="10dp">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/str_check_for_updates"
                        android:textColor="@color/textColor"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium" />
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/str_manually_check_for_the_latest"
                        android:textColor="@color/iconSecondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/outlineVariant"
                    android:layout_marginVertical="4dp" />

                <!-- Open Source Licenses Setting -->
                <LinearLayout
                    android:id="@+id/btnOpenSourceLicenses"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="10dp">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/str_open_source_licenses"
                        android:textColor="@color/textColor"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium" />
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/str_view_third_party_software_licenses"
                        android:textColor="@color/iconSecondary"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
    <!-- About Page Content (Bento Style Layout) -->
    <ScrollView
        android:id="@+id/layoutAboutContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layoutTopHeader"
        android:visibility="gone"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="100dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero Bento Card: About Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_bento_primary"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center"
                android:elevation="8dp">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@mipmap/ic_launcher_round" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/app_name"
                    android:textColor="@color/textColor"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/tvAboutVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/colorSecondary"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:background="@drawable/bg_pill_accent"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.3"
                    android:text="@string/str_a_privacy_friendly_open_source"
                    android:textColor="@color/iconSecondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Support & Community Bento Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_hero_bento_secondary"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center_horizontal"
                android:elevation="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/str_support_amp_feedback"
                    android:textColor="@color/textColor"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/str_librecuts_is_open_source_help"
                    android:textColor="@color/iconSecondary"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStarGithub"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:text="@string/str_star_on_github"
                    android:textColor="@color/onPrimaryContainer"
                    android:backgroundTint="@color/colorPrimary"
                    app:cornerRadius="14dp"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    app:icon="@drawable/ic_star_24"
                    app:iconTint="@color/onPrimaryContainer"
                    app:iconGravity="textStart"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTranslate"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/str_help_translate"
                    android:textColor="@color/textColor"
                    android:backgroundTint="@color/surfaceContainerHigh"
                    app:strokeColor="@color/outline"
                    app:strokeWidth="1dp"
                    app:cornerRadius="14dp"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    app:icon="@drawable/ic_translate_24"
                    app:iconTint="@color/textColor"
                    app:iconGravity="textStart"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReportBug"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/str_report_a_bug"
                    android:textColor="@color/textColor"
                    android:backgroundTint="@color/surfaceContainerHigh"
                    app:strokeColor="@color/outline"
                    app:strokeWidth="1dp"
                    app:cornerRadius="14dp"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    app:icon="@drawable/ic_bug_24"
                    app:iconTint="@color/textColor"
                    app:iconGravity="textStart"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSponsor"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/str_sponsor_project"
                    android:textColor="#ff69b4"
                    android:backgroundTint="@color/surfaceContainerHigh"
                    app:strokeColor="#ff69b4"
                    app:strokeWidth="1dp"
                    app:cornerRadius="14dp"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    app:icon="@drawable/ic_heart_24"
                    app:iconTint="#ff69b4"
                    app:iconGravity="textStart"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="32dp"
                android:alpha="0.4"
                android:text="@string/str_made_by_tharun_birla"
                android:textColor="@color/textColor"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>
    <!-- Floating Glass Bottom Navigation（悬浮毛玻璃导航条：项目 / 设置 / 关于） -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="44dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_glass_nav"
        android:elevation="0dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:paddingVertical="6dp">

        <LinearLayout
            android:id="@+id/tabProjects"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_active_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivProjects"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_folder_24"
                app:tint="@color/colorPrimary" />

            <TextView
                android:id="@+id/tvProjectsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:singleLine="true"
                android:text="@string/str_projects"
                android:textColor="@color/colorPrimary"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabSettings"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivSettings"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_settings_24"
                app:tint="@color/inactiveTool" />

            <TextView
                android:id="@+id/tvSettingsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:singleLine="true"
                android:text="@string/str_settings"
                android:textColor="@color/inactiveTool"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabAbout"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivAbout"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_info_24"
                app:tint="@color/inactiveTool" />

            <TextView
                android:id="@+id/tvAboutLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:singleLine="true"
                android:text="@string/str_about"
                android:textColor="@color/inactiveTool"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
